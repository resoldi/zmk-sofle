#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    thk: thk {
        compatible = "zmk,behavior-hold-tap";
        label = "tap-hold key";
        bindings = <&mt>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <170>;
        flavor = "tap-preferred";
    };

    thl: thl {
        compatible = "zmk,behavior-hold-tap";
        label = "tap-hold layer";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        flavor = "balanced";
    };

    new_behavior: new_behavior {
        compatible = "zmk,behavior-tap-dance";
        label = "NEW_BEHAVIOR";
        #binding-cells = <0>;
        bindings = <&kp LCTRL>, <&kp LALT>;
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE   &kp N1     &kp N2    &kp N3         &kp N4            &kp N5             &kp LC(UP)     &kp N6              &kp N7            &kp N8     &kp N9    &kp N0         &kp C_POWER
&kp ESCAPE  &kp Q      &kp W     &kp E          &kp R             &kp T              &kp LC(DOWN)   &kp Y               &kp U             &kp I      &kp O     &kp P          &kp MINUS
&kp TAB     &kp A      &kp S     &kp D          &kp F             &kp G              &kp LC(RIGHT)  &kp H               &kp J             &kp K      &kp L     &kp SEMICOLON  &kp APOS
&kp LSHFT   &kp Z      &kp X     &kp C          &kp V             &kp B              &kp LC(LEFT)   &kp N               &kp M             &kp COMMA  &kp DOT   &kp SLASH      &kp BACKSLASH
&kp C_MUTE  &kp LCTRL  &kp LALT  &new_behavior  &thl 1 LS(SPACE)  &thk LGUI SPACE    &kp ENTER      &thk RSHIFT RETURN  &thl 2 BACKSPACE  &kp RCTRL  &kp RALT  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "Base";
        };

        Navi_Func {
            bindings = <
&trans       &kp F1  &kp F2  &kp F3  &kp F4          &kp F5     &mmv MOVE_UP     &kp F6    &kp F7    &kp F8  &kp F9     &kp F10  &bt BT_SEL 0
&trans       &trans  &trans  &trans  &kp LS(LG(N4))  &kp F11    &mmv MOVE_DOWN   &kp F12   &trans    &trans  &trans     &trans   &bt BT_SEL 1
&kp LS(TAB)  &trans  &trans  &trans  &trans          &trans     &mmv MOVE_LEFT   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans   &bt BT_SEL 2
&trans       &trans  &trans  &trans  &trans          &trans     &mmv MOVE_RIGHT  &trans    &trans    &trans  &trans     &trans   &trans
&trans       &trans  &trans  &trans  &trans          &trans     &trans           &trans    &trans    &trans  &trans     &trans
            >;

            label = "Nav/Fn";
        };

        Symbol {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LPAR  &kp RPAR  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans
            >;

            label = "Sym";
            sensor-bindings = <&inc_dec_kp 0 0>;
        };
    };
};
